# ========================================
# PROYECTO CUPIDO - Variables de Entorno
# ========================================
# Copia este archivo como .env y completa con tus credenciales
# NUNCA subas el archivo .env al repositorio

# ========================================
# BASE DE DATOS
# ========================================
# URL de conexión de Neon PostgreSQL
# Formato: postgresql://usuario:password@host/database?sslmode=require
DATABASE_URL=postgresql://usuario:password@host/database?sslmode=require

# ========================================
# ANTHROPIC (CLAUDE AI)
# ========================================
# Obtén tu API key en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-xxx

# ========================================
# WHATSAPP (ULTRAMSG)
# ========================================
# Configura tu instancia en: https://user.ultramsg.com/
ULTRAMSG_INSTANCE_ID=instance123456
ULTRAMSG_TOKEN=tu_token_aqui
GRUPO_CUPIDO_ID=573001234567-1234567890@g.us

# ========================================
# AUTENTICACIÓN (JWT)
# ========================================
# Clave secreta para firmar tokens JWT (genera una clave segura)
# Puedes generar una con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=tu_clave_secreta_muy_segura_cambiar_en_produccion

# Tiempo de expiración del token en horas (default: 24)
JWT_EXPIRATION_HOURS=24

# ========================================
# USUARIOS AUTORIZADOS
# ========================================
# Para generar el hash de una contraseña:
# python -c "import hashlib; print(hashlib.sha256('TU_PASSWORD'.encode()).hexdigest())"

# Usuario 1
AUTH_USER_1_EMAIL=usuario1@example.com
AUTH_USER_1_PASSWORD_HASH=hash_sha256_de_la_password
AUTH_USER_1_NAME=Nombre Usuario 1
AUTH_USER_1_ROLE=admin

# Usuario 2
AUTH_USER_2_EMAIL=usuario2@example.com
AUTH_USER_2_PASSWORD_HASH=hash_sha256_de_la_password
AUTH_USER_2_NAME=Nombre Usuario 2
AUTH_USER_2_ROLE=admin

# ========================================
# FRONTEND
# ========================================
# URL Base del Frontend (para links en WhatsApp)
# Desarrollo: http://localhost:8080
# Producción: https://tu-dominio.com
FRONTEND_BASE_URL=http://localhost:8080

# ========================================
# VALIDACIÓN AUTOMÁTICA
# ========================================
VALIDACION_ENABLED=true
VALIDACION_HORARIOS=3,15
VALIDACION_TIMEOUT=10
VALIDACION_RATE_LIMIT=2
VALIDACION_MAX_FALLOS=2
VALIDACION_AUTO_REACTIVAR=true

# ========================================
# SCRAPER
# ========================================
DELAY_BETWEEN_REQUESTS=2
VERBOSE_MODE=True

# ========================================
# LOGGING
# ========================================
LOG_LEVEL=INFO
