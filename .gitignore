# ========================================
# PROYECTO CUPIDO - GitIgnore
# ========================================

# ========================================
# SECRETS & CREDENTIALS (CRITICAL!)
# ========================================
.env
.env.local
.env.*.local
*.pem
*.key
credentials.json
secrets.json

# ========================================
# PYTHON
# ========================================
# Virtual environments
venv/
env/
ENV/
.venv/
.virtualenv/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# ========================================
# PROJECT-SPECIFIC LOGS & DATA
# ========================================
# Test logs (timestamped directories)
test_logs_*/
test_logs/
test_logs_*/**

# Webhook logs
webhook_logs/
webhook_logs/**
*.webhook.log

# Property info files
property_info_files/
property_info_files/**

# Data files
data/
data/*.csv
data/*.json
data/*.xlsx
data/*.log

# Log files
*.log
logs/
*.log.*

# JSON result files (ejemplos generados por tests)
ejemplo_resultado_*.json
*_resultado_*.json

# ========================================
# DATABASES
# ========================================
*.db
*.sqlite
*.sqlite3
*.db-journal

# ========================================
# IDEs & EDITORS
# ========================================
# VSCode
.vscode/
.vscode/**
*.code-workspace

# PyCharm
.idea/
.idea/**
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# ========================================
# OPERATING SYSTEMS
# ========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory
.Trash-*

# ========================================
# TEMPORARY FILES
# ========================================
# Temp files
*.tmp
*.temp
*.bak
*.backup
~*

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb_checkpoints/

# pyenv
.python-version

# pipenv
Pipfile.lock

# poetry
poetry.lock

# ========================================
# NGROK
# ========================================
ngrok
ngrok.exe
ngrok.yml

# ========================================
# DOCUMENTATION BUILD OUTPUTS
# ========================================
docs/_build/
site/

# ========================================
# NODE (if using any JS tooling)
# ========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# ========================================
# UTILITY SCRIPTS (local only)
# ========================================
run_migration.py
scripts/run_migration_*.py
scripts/check_migrations.py
scripts/delete_*.py
scripts/check_tu360_images.py
scripts/update_tu360_images.py
