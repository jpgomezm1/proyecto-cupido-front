{
  "root": "Respuesta",
  "components": {
    "Respuesta": {
      "signature": "Respuesta(bloques: (Texto | Cifras | Termometro | Barras | Espejo | Dona | RangoPrecio | Tabla | Inmuebles | Compradores | Hallazgos | Aviso | Siguientes)[])",
      "description": "La raíz: los bloques de la respuesta, en orden de lectura."
    },
    "Texto": {
      "signature": "Texto(texto: string)",
      "description": "Un párrafo corto. El primero de la respuesta lleva la conclusión (qué significa para captar, vender o negociar)."
    },
    "Cifras": {
      "signature": "Cifras(items: {valor: string, etiqueta: string, detalle?: string}[])",
      "description": "Fila de 2 a 4 cifras clave grandes. Úsala casi siempre, arriba."
    },
    "Termometro": {
      "signature": "Termometro(titulo: string, valor: number, maximo: number, etiqueta: string, referencia?: number, referenciaEtiqueta?: string)",
      "description": "Tubo de termómetro de 0 a maximo lleno hasta el valor: qué tan caliente está una zona."
    },
    "Barras": {
      "signature": "Barras(titulo: string, items: {etiqueta: string, valor: number, texto: string}[], nota?: string)",
      "description": "Ranking de barras horizontales (zonas, barrios, categorías)."
    },
    "Espejo": {
      "signature": "Espejo(titulo: string, izquierda: string, derecha: string, filas: {etiqueta: string, izq: number, der: number}[], nota?: string)",
      "description": "Barras enfrentadas: oferta a la izquierda contra demanda a la derecha, por banda de precio o categoría."
    },
    "Dona": {
      "signature": "Dona(titulo: string, partes: {etiqueta: string, valor: number}[], centro?: string, centroTexto?: string)",
      "description": "Reparto en dona con la cifra principal al centro (tipos que piden, presupuestos)."
    },
    "RangoPrecio": {
      "signature": "RangoPrecio(titulo: string, sugerido: number, minimo: number, maximo: number, precioActual?: number, nota?: string)",
      "description": "Rango de precio con el sugerido marcado (y el precio actual, si hay). Para estimar precio de captación."
    },
    "Tabla": {
      "signature": "Tabla(titulo: string, columnas: string[], filas: string[][], destacar?: number, nota?: string)",
      "description": "Tabla comparativa simple (comparar inmuebles, costo mensual por concepto)."
    },
    "Inmuebles": {
      "signature": "Inmuebles(titulo: string, ids: number[])",
      "description": "Tarjetas reales de inmuebles de Fynder (foto, precio y botón de llave) a partir de sus ids."
    },
    "Compradores": {
      "signature": "Compradores(titulo: string, items: {resumen: string, presupuesto?: string, encaje?: number, razones?: string[]}[])",
      "description": "Lista de pedidos de compradores que encajan, sin datos personales."
    },
    "Hallazgos": {
      "signature": "Hallazgos(titulo: string, items: {prioridad: \"alta\" | \"media\" | \"baja\", titulo: string, accion: string}[])",
      "description": "Diagnóstico priorizado: hallazgo + acción."
    },
    "Aviso": {
      "signature": "Aviso(texto: string, tono: \"info\" | \"oportunidad\" | \"alerta\")",
      "description": "Una frase destacada (oportunidad, alerta o dato)."
    },
    "Siguientes": {
      "signature": "Siguientes(preguntas: string[])",
      "description": "Botones con las siguientes preguntas sugeridas. Va al final."
    }
  },
